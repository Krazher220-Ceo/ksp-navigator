# Адрес FastAPI. В разработке — локальный сервер, в проде — Cloudflare
# Tunnel, потом VPS. Без завершающего слэша.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth: вход по почте и паролю.
# ⚠️ Сюда идёт ТОЛЬКО публичный ключ anon. SUPABASE_SERVICE_ROLE_KEY во
# фронтенд не попадает никогда — он даёт полный доступ к базе мимо всех
# проверок и живёт в .env сервера.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ссылка на бота в Telegram — вторая дверь входа. Не задана: кнопка
# «Войти через Telegram» рисуется неактивной, вместо неё не выдумывается
# несуществующий адрес.
NEXT_PUBLIC_TELEGRAM_BOT_URL=
