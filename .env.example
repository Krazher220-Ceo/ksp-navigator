# Токен Telegram-бота, выдаётся @BotFather
TELEGRAM_BOT_TOKEN=

# Порядок провайдеров LLM через запятую (core/llm_client.py, блок Б2).
# Клиент пробует их слева направо: провайдер без ключа ниже пропускается
# молча (не настроен — это штатно), провайдер, у которого запрос не
# получился после своих ретраев, — переход к следующему в списке.
# Список расширяемый: добавить провайдера — значит дописать его сюда
# и задать для него {ИМЯ}_API_KEY/{ИМЯ}_MODEL ниже.
LLM_PROVIDERS=deepseek,gemini,grok,openai,anthropic

# DeepSeek — основной провайдер, платный ключ.
DEEPSEEK_API_KEY=
# deepseek-v4-flash — быстрее и дешевле, хватает для генерации КСП.
# deepseek-v4-pro — дороже, но качественнее на сложных случаях, менять
# на неё одной строкой при необходимости. Актуальный список моделей
# смотри на platform.deepseek.com — они меняются, "deepseek-chat"
# больше не существует (был снят самим DeepSeek).
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gemini (Google) — резервный, на бесплатном дневном лимите.
GEMINI_API_KEY=
# Впиши актуальное имя модели из документации Google — оно меняется чаще,
# чем хотелось бы, поэтому дефолта в коде намеренно нет.
GEMINI_MODEL=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Grok (xAI) — резервный, на бесплатном дневном лимите.
GROK_API_KEY=
GROK_MODEL=
# GROK_BASE_URL=https://api.x.ai/v1

# OpenAI (ChatGPT) — резервный, на бесплатном дневном лимите.
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (Claude) — резервный, на бесплатном дневном лимите.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Публичный HTTPS-адрес Mini App (Cloudflare Tunnel, launchd/, блок Б11)
WEBAPP_URL=

# Порт локального FastAPI-сервера Mini App
WEBAPP_PORT=8000

# Ф2: откуда браузеру разрешено дёргать /api/v1/*. Через запятую, без
# пробелов в самих адресах. Пусто — остаётся только адрес разработки
# http://localhost:3000. Звёздочка запрещена: сервер публично доступен
# через Cloudflare Tunnel.
CORS_ORIGINS=http://localhost:3000

# Ф3: общий секрет проекта Supabase, которым подписаны JWT кабинета
# (Dashboard -> Project Settings -> API -> JWT Secret). Не задан — вход
# по почте не работает; на вход из Telegram это не влияет.
# ВНИМАНИЕ: это серверный секрет. Во фронтенд он не попадает никогда —
# туда идёт только NEXT_PUBLIC_SUPABASE_ANON_KEY.
SUPABASE_JWT_SECRET=

# Путь к файлу базы данных SQLite (относительно корня проекта)
DB_PATH=storage/app.db

# С2: до подтверждённого переноса используется SQLite. После успешного
# запуска scripts/migrate_sqlite_to_supabase.py --apply переключите на
# supabase; резервный путь SQLite остаётся доступен этим же переключателем.
DB_BACKEND=sqlite
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# М7: chat_id, куда бот шлёт уведомление о завершившемся инциденте
# живучести (пропадала сеть/бот, потом восстановилось). Обычно это
# личный chat_id автора в Telegram — узнать его можно, написав боту
# @userinfobot. Не задан — уведомления не шлются, только пишутся в БД.
ADMIN_TELEGRAM_CHAT_ID=

# Временное снятие лимитов для текущего пользователя; оставьте пустым, чтобы /admin был недоступен.
ADMIN_PASSWORD=

# С1: запись отправляется в облачный API xAI. Локальной транскрипции нет.
STT_BACKEND=xai
XAI_API_KEY=
STT_LANGUAGE=ru

# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
