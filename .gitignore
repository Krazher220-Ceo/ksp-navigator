# Секреты
.env

# База данных (SQLite, режим WAL — см. core/db.py, блок Б1)
storage/app.db
storage/app.db-journal
storage/app.db-wal
storage/app.db-shm
# Бэкапы перед миграциями (протокол PLAN_STAGE2.md, К2.1) — реальные
# данные учителя, не должны попасть в коммит так же, как сама app.db.
storage/app.db.bak.*

# Загруженные и сгенерированные файлы пользователей
storage/uploads/
storage/generated/

# Бэкапы БД (scripts/backup_db.sh, блок Б11)
backup/

# Python
__pycache__/
*.pyc
venv/
.venv/

# Логи
*.log
logs/

# Тесты
.pytest_cache/

# macOS
.DS_Store

# Архив планов и отчётов прошлых этапов (решение автора 27.08.2026).
# Файлы физически лежат в archive/ и никуда не делись — просто убраны из
# репозитория, чтобы не путать исполнителя актуального плана.
archive/

# Мусорная папка в корне (блок Э5, PLAN.md) — похоже на след неудачной
# команды вида "git clone https://..." без кавычек: буквальный путь
# "https:/github.com/..." со своим вложенным .git внутри. Дважды уже
# попадалась в git status, один раз могла уехать в коммит по недосмотру.
# Сам файл не удаляется этим блоком — решение об этом за автором.
https:/

# Нормативная база РК — первоисточники приказов (33 МБ PDF и DOCX) и
# рабочие выдачи генератора с ФИО настоящего педагога. В git им не место
# ни по размеру, ни по персональным данным. Что там лежит и откуда взято —
# в "Нормативная база РК/README.md".
Нормативная база РК/

# Аудиозаписи уроков в корне проекта. Правило "аудио на диске после
# обработки — ноль" (MASTER.md) относится к пайплайну; файл, положенный
# автором руками, пайплайн не трогает, но и в репозиторий он не идёт.
# Слэш в начале намеренно: tests/fixtures/audio_lesson_snippet.m4a
# закоммичен и нужен прогону.
/*.m4a

# Конфигурация инструментов разработки — своя на каждой машине.
.claude/
.agents/
.cursor/
skills-lock.json
